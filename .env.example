# Skapa en `.env` fil med enligt denna struktur för lokal utveckling

# Exempel: gör override på feature flaggor
FEATURE_DDB=true
FEATURE_ADMIN=true
ADMIN_PASSWORD=admin123

# AWS inställningar för att kunna köra lokalt (Localstack)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566